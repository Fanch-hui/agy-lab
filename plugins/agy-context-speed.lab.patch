+    ['native:gemini-4-hydrogen', null, true],
   ]);
+});
+
+test('separates a third-party executor from native planner cost and telemetry', () => {
+  const steps = [
+    step(0, { source: 'USER_EXPLICIT', type: 'USER_INPUT' }),
+    step(2, {
+      source: 'MODEL', type: 'PLANNER_RESPONSE',
+      input_tokens: 10_000, cache_read_tokens: 30_000, output_tokens: 200,
+      tool_calls: [{ name: 'exit_plan_mode' }],
+    }),
+    step(10, {
+      source: 'MODEL', type: 'PLANNER_RESPONSE',
+      input_tokens: 5_000, cache_read_tokens: 45_000, output_tokens: 600,
+    }),
+  ];
+  const calls = [
+    { input: 10_000, cached: 30_000, output: 200, ttft: 6, stream: 2, maxContextTokens: 512_000, responseModel: 'gemini-4-neon' },
+    { input: 5_000, cached: 45_000, output: 600, ttft: 2, stream: 1.5, maxContextTokens: 512_000, responseModel: 'gemini-flash-worker-agy', modelDisplayName: 'gpt-6.2-sol · ChatGPT 订阅 (Medium)' },
+  ];
+
+  const m = analyzeSteps(steps, { calls });
+  const planner = m.models.find(view => view.key === 'native:gemini-4-neon');
+  const external = m.models.find(view => view.key === 'ext:gpt-6.2-sol:ChatGPT 订阅');
+  assert.ok(planner);
+  assert.ok(external);
+  assert.equal(planner.role, 'planner');
+  assert.equal(external.role, 'executor');
+  assert.equal(external.isExternal, true);
+  assert.equal(external.source, 'ChatGPT 订阅');
+  assert.equal(external.cost.totalCalls, external.calls);
+  assert.ok(external.cost.total > 0);
+  assert.equal(m.cost.totalCalls, planner.calls);
+  assert.equal(m.cost.tokens.input, planner.totals.input);
+  assert.equal(m.cost.tokens.output, planner.totals.output);
+  assert.equal(m.thirdParty.totalCalls, external.calls);
 });
